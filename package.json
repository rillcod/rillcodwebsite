    "db:types:linked": "npx supabase gen types typescript --linked > src/types/supabase.ts",
    "supabase:deploy:paystack-webhook": "node scripts/deploy-paystack-webhook.mjs",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:assets": "node scripts/gen-android-icons.mjs",
    "android:release": "cd android && ./gradlew bundleRelease",
    "cf:secret:fcm": "node scripts/set-cloudflare-fcm-secret.mjs",
    "test:smoke:ai": "tsx scripts/smoke-ai-paths.ts",
