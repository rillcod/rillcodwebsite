# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# env files — never commit secrets
.env
.env.local
.env*.local

# Cursor / Claude — machine-local agent & IDE settings
.claude/settings.local.json
.claude/**/settings.local.json
.claude/worktrees/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/rillcod_flutter_mobile
scripts/setup-admins.mjs

# Audit/Report summaries
/*.md

# PWA fallback files
/public/fallback-*.js

# one-off local DB scripts (service-role access) — never commit
/scratch_*.js

# Local data exports / backups (contain student PII — never commit)
report_name_mismatches.csv
scratch_*.json
*_backup.json

# Scratch TS scripts (service-role access)
scratch_*.ts

# Native push / Play signing credentials (never commit)
android/app/google-services.json
ios/App/App/GoogleService-Info.plist
google-services.json
GoogleService-Info.plist
*-firebase-adminsdk*.json
firebase-adminsdk*.json
android/keystore.properties
android/keystore/
store/keystore-backup-README.txt
*.aab
*.apk
.idea/
.env*

# Local generated audit, render, and isolated database artifacts
/output/
/tmp/
