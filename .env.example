# Copy to .env.local and fill in values (never commit .env.local).

# Canonical public site origin (must match the host users browse — use www)
NEXT_PUBLIC_APP_URL=https://www.rillcod.com

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Supabase CLI (your laptop / CI only — not read by Next.js) ──────────────
# Create a token: https://supabase.com/dashboard/account/tokens (starts with sbp_)
# Then link once: npm run supabase:link
# Push migrations: npm run db:push:yes
#
# Git Bash / macOS / Linux:
#   export SUPABASE_ACCESS_TOKEN=sbp_your_token_here
# Windows CMD:
#   set SUPABASE_ACCESS_TOKEN=sbp_your_token_here
# Windows PowerShell:
#   $env:SUPABASE_ACCESS_TOKEN="sbp_your_token_here"
#
# SUPABASE_ACCESS_TOKEN=

PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Mobile app deep link URL (optional, for billing reminders)
MOBILE_APP_URL=rillcod://

# Cron job secrets (generate random secure strings)
# Used by: billing-reminders, invoice-reminders, process-certificates
BILLING_CRON_SECRET=

# Used by: live-session-reminders, process-notifications, streak-reminder, term-scheduler, weekly-summary
CRON_SECRET=

# Internal ops: registration payment alerts (email via SendPulse external API)
ADMIN_OPS_EMAIL=

# Supabase app_settings row (not an env var): key default_registration_program_id = UUID of default programmes.price for public registration.

STRIPE_SECRET_KEY=

# Fail-closed Meta/WhatsApp production approval gate.
# Leave false while the Meta app is pending. Set true only after approval.
WHATSAPP_CLOUD_API_APPROVED=false

SENDPULSE_API_ID=
SENDPULSE_API_SECRET=

ENABLE_PAYMENTS=false

# ── Web Push (PWA / browser) ──────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Native push (Capacitor Android FCM + iOS APNs) ─────────────────────────────
# Firebase service account JSON as a single line (Android FCM send).
# Download from Firebase Console → Project settings → Service accounts.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Place android/app/google-services.json from Firebase (Android app package com.rillcod.academy).
# Do not commit the real file — see android/app/google-services.json.example

# Apple Push (.p8 Auth Key) for iOS Capacitor tokens
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=com.rillcod.academy
# APNS_KEY_P8=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# APNS_PRODUCTION=false
