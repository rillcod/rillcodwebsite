# Copy to .env.local and fill in values (never commit .env.local).

# Canonical public site origin (must match the host users browse — use www)
NEXT_PUBLIC_APP_URL=https://www.rillcod.com

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Supabase CLI (your laptop / CI only — not read by Next.js) ──────────────
# Create a token: https://supabase.com/dashboard/account/tokens (starts with sbp_)
# Then link once: npm run supabase:link
# Push migrations: npm run db:push:yes
#
# Git Bash / macOS / Linux:
#   export SUPABASE_ACCESS_TOKEN=sbp_your_token_here
# Windows CMD:
#   set SUPABASE_ACCESS_TOKEN=sbp_your_token_here
# Windows PowerShell:
#   $env:SUPABASE_ACCESS_TOKEN="sbp_your_token_here"
#
# SUPABASE_ACCESS_TOKEN=

PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Mobile app deep link URL (optional, for billing reminders)
MOBILE_APP_URL=rillcod://

# Cron job secrets (generate random secure strings)
# Used by: billing-reminders, invoice-reminders, process-certificates
BILLING_CRON_SECRET=

# Used by: live-session-reminders, process-notifications, streak-reminder, term-scheduler, weekly-summary
CRON_SECRET=

# Internal ops: registration payment alerts (email via SendPulse external API)
ADMIN_OPS_EMAIL=

# Supabase app_settings row (not an env var): key default_registration_program_id = UUID of default programmes.price for public registration.

STRIPE_SECRET_KEY=

# Meta/WhatsApp gate: review permits only listed test numbers; approved permits production delivery.
# Keep the legacy boolean false; use WHATSAPP_CLOUD_API_MODE for new deployments.
WHATSAPP_CLOUD_API_APPROVED=false
WHATSAPP_CLOUD_API_MODE=review
WHATSAPP_REVIEW_TEST_NUMBERS=+2348116600091

SENDPULSE_API_ID=
SENDPULSE_API_SECRET=

# Email delivery status webhooks (SendPulse SMTP events and/or Resend/Svix)
# Easiest: reuse CRON_SECRET — no extra secret needed.
# Point the provider at: https://www.rillcod.com/api/webhooks/email-status?token=<CRON_SECRET>
# Or send header x-webhook-secret / Authorization: Bearer <CRON_SECRET>
# Optional override only if you want a separate secret:
# EMAIL_STATUS_WEBHOOK_SECRET=
# Optional alias used by inbound email bridges
# INBOUND_EMAIL_WEBHOOK_SECRET=
# Resend dashboard webhook signing secret (whsec_...) when using Resend events
# RESEND_WEBHOOK_SECRET=

ENABLE_PAYMENTS=false

# ── AI engine ─────────────────────────────────────────────────────────────────
# Google AI Studio (free tier, 1M-token context): https://aistudio.google.com/apikey
# This is the PRIMARY provider — it is tried before anything that costs money.
GEMINI_API_KEY=

# Optional extra free keys. Each Google account carries its own free quota, so the
# engine round-robins across all of them and only downgrades the model once every
# key is rate-limited. Add as many as you have — 3 keys ≈ 3× the free daily calls.
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GEMINI_API_KEY_4=
# GEMINI_API_KEY_5=
# Or supply them all at once, comma-separated:
# GEMINI_API_KEYS=key1,key2,key3

# OpenRouter — FALLBACK only, used when every Gemini key is exhausted.
# The model queues pin `:free` variants, so this stays free unless you change them.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── Web Push (PWA / browser) ──────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Native push (Capacitor Android FCM + iOS APNs) ─────────────────────────────
# Firebase service account JSON as a single line (Android FCM send).
# Download from Firebase Console → Project settings → Service accounts.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Place android/app/google-services.json from Firebase (Android app package com.rillcod.academy).
# Do not commit the real file — see android/app/google-services.json.example

# Apple Push (.p8 Auth Key) for iOS Capacitor tokens
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=com.rillcod.academy
# APNS_KEY_P8=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# APNS_PRODUCTION=false
