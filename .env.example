# Copy to .env.local AND .env, then fill in values (neither file is ever committed).
#
# Both files are kept identical on purpose: every variable lives in both, so nothing
# silently falls back to a stale value depending on which file a tool happens to load.
#
# Production runs on Cloudflare. Public values live in wrangler.toml [vars]; secrets
# live in Cloudflare Workers secrets. Push both with:  npm run cf:secrets
#
# NEVER paste a value that reads like [SENSITIVE], YOUR_KEY_HERE, or any other
# placeholder. The sync script rejects them — uploading one passes the app's
# "is it configured?" checks and then fails in production as a confusing runtime
# error. (This exact mistake took public receipt upload down; see docs/CLOUDFLARE_DEPLOY.md.)

# ── Site ──────────────────────────────────────────────────────────────────────
# Canonical public origin (must match the host users browse — use www)
NEXT_PUBLIC_APP_URL=https://www.rillcod.com
# Mobile app deep link (optional, used by billing reminders)
MOBILE_APP_URL=rillcod://

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase CLI (your laptop / CI only — not read by Next.js).
# Create a token: https://supabase.com/dashboard/account/tokens (starts with sbp_)
# Then: npm run supabase:link  →  npm run db:push:yes
SUPABASE_ACCESS_TOKEN=

# ── Payments (Paystack) ───────────────────────────────────────────────────────
ENABLE_PAYMENTS=false
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
STRIPE_SECRET_KEY=

# ── Email delivery ────────────────────────────────────────────────────────────
# Resend is primary; SendPulse is the automatic fallback.
RESEND_API_KEY=
# Display form is fine: "Rillcod Technologies <noreply@rillcod.com>"
RESEND_FROM_EMAIL=
# Resend dashboard webhook signing secret (whsec_…) for delivery events
RESEND_WEBHOOK_SECRET=
SENDPULSE_API_ID=
SENDPULSE_API_SECRET=

# Internal ops alerts: registration / bank-transfer payment notices.
# Single address only — the app validates one email, not a comma-separated list.
ADMIN_OPS_EMAIL=

# Email status webhooks: easiest is to reuse CRON_SECRET — no extra secret needed.
# Point the provider at https://www.rillcod.com/api/webhooks/email-status?token=<CRON_SECRET>
# Optional overrides only if you want separate secrets:
# EMAIL_STATUS_WEBHOOK_SECRET=
# INBOUND_EMAIL_WEBHOOK_SECRET=

# ── Storage (Cloudflare R2) ───────────────────────────────────────────────────
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── AI engine (free-first) ────────────────────────────────────────────────────
# Google AI Studio (free tier): https://aistudio.google.com/apikey
# PRIMARY provider — tried before anything that costs money.
GEMINI_API_KEY=
# Optional extra free keys. Each Google account carries its own free quota, so the
# engine round-robins across all of them and only downgrades the model once every
# key is rate-limited. 3 keys ≈ 3× the free daily calls.
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# Or supply them comma-separated:
# GEMINI_API_KEYS=key1,key2,key3

# OpenRouter — FALLBACK only, used when every Gemini key is exhausted.
# The model queues pin `:free` variants, so this stays free unless you change them.
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=

# ── Live classes (LiveKit, Jitsi-as-a-Service backup) ─────────────────────────
# Must be a wss:// URL — the client rejects anything else.
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
JAAS_APP_ID=
JAAS_KEY_ID=
JAAS_PRIVATE_KEY=

# ── Redis (Upstash) ───────────────────────────────────────────────────────────
# Caching + rate limiting. Both optional: the app falls back to an in-memory store.
# MUST be the https REST URL from the Upstash console — NOT a redis:// connection
# string. The client throws on anything else, and the app treats a malformed value
# as "not configured" rather than crashing.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Push notifications ────────────────────────────────────────────────────────
# Web Push (PWA / browser)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Native push (Capacitor Android FCM). Firebase service account JSON on ONE line —
# Firebase Console → Project settings → Service accounts.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
FIREBASE_SERVICE_ACCOUNT_JSON=

# Place android/app/google-services.json from Firebase (package com.rillcod.academy).
# Do not commit the real file — see android/app/google-services.json.example

# Apple Push (.p8 Auth Key) for iOS Capacitor tokens
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=com.rillcod.academy
# APNS_KEY_P8=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# APNS_PRODUCTION=false

# ── WhatsApp ──────────────────────────────────────────────────────────────────
# Graph API endpoint, e.g. https://graph.facebook.com/v19.0/<phone-number-id>/messages
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Signs inbound webhooks — without it every unsigned webhook is rejected and
# inbound WhatsApp goes dark.
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Meta gate: `review` permits only listed test numbers; `approved` permits production
# delivery. Keep the legacy boolean false; use WHATSAPP_CLOUD_API_MODE going forward.
WHATSAPP_CLOUD_API_APPROVED=false
WHATSAPP_CLOUD_API_MODE=review
WHATSAPP_REVIEW_TEST_NUMBERS=+2348116600091

# Fallback group invite when none is configured in the whatsapp_groups table
NEXT_PUBLIC_SUMMER_SCHOOL_WHATSAPP_GROUP=

# ── Cron / scheduled jobs ─────────────────────────────────────────────────────
# Generate random secure strings. Jobs are triggered by cron-job.org and the
# wrangler.toml [triggers] block — see src/lib/operations/cron-registry.ts.
CRON_SECRET=
BILLING_CRON_SECRET=

# Supabase app_settings row (not an env var): key `default_registration_program_id`
# = UUID of the default programme, so public registration can resolve programs.price.
